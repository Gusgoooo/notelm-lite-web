{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IntentRoutingResult",
  "description": "NotebookGo 意图路由结果。用于区分 qa / doc_edit / doc_replace 并驱动后续更新策略。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "intent_type",
    "confidence",
    "target_scope",
    "answer_mode",
    "citation_required",
    "allow_no_source_answer",
    "show_update_button",
    "requires_user_confirm_to_apply",
    "on_confirm_update_mode",
    "qa_update_policy",
    "reason_codes",
    "notes"
  ],
  "properties": {
    "intent_type": {
      "type": "string",
      "enum": ["qa", "doc_edit", "doc_replace"]
    },
    "confidence": {
      "type": "string",
      "enum": ["high", "medium", "low"]
    },
    "target_scope": {
      "type": "string",
      "enum": ["none", "section", "full_document"]
    },
    "answer_mode": {
      "type": "string",
      "enum": ["source_grounded_only", "preview_edit", "preview_replace"]
    },
    "citation_required": {
      "type": "boolean"
    },
    "allow_no_source_answer": {
      "type": "boolean"
    },
    "show_update_button": {
      "type": "boolean",
      "const": true
    },
    "requires_user_confirm_to_apply": {
      "type": "boolean",
      "const": true
    },
    "on_confirm_update_mode": {
      "type": "string",
      "enum": ["incremental_merge", "apply_edit", "apply_replace"]
    },
    "qa_update_policy": {
      "type": "string",
      "enum": ["extract_compare_minimal_merge", "n_a"]
    },
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "string",
        "enum": [
          "HAS_ACTIVE_DOC",
          "NO_ACTIVE_DOC",
          "HAS_OBJECT_REFERENCE",
          "NO_OBJECT_REFERENCE",
          "HAS_EDIT_ACTION",
          "NO_EDIT_ACTION",
          "HAS_REPLACE_SIGNAL",
          "NO_REPLACE_SIGNAL",
          "EDITING_MODE",
          "DISCUSSION_MODE",
          "MIXED_MODE",
          "TOPIC_DISCUSSION_ONLY",
          "OBJECT_OPERATION",
          "SHORT_EDIT_FEEDBACK"
        ]
      },
      "uniqueItems": true
    },
    "notes": {
      "type": "string",
      "minLength": 1,
      "maxLength": 260
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "intent_type": { "const": "qa" }
        }
      },
      "then": {
        "properties": {
          "target_scope": { "const": "none" },
          "answer_mode": { "const": "source_grounded_only" },
          "citation_required": { "const": true },
          "allow_no_source_answer": { "const": false },
          "on_confirm_update_mode": { "const": "incremental_merge" },
          "qa_update_policy": { "const": "extract_compare_minimal_merge" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "intent_type": { "const": "doc_edit" }
        }
      },
      "then": {
        "properties": {
          "target_scope": { "const": "section" },
          "answer_mode": { "const": "preview_edit" },
          "on_confirm_update_mode": { "const": "apply_edit" },
          "qa_update_policy": { "const": "n_a" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "intent_type": { "const": "doc_replace" }
        }
      },
      "then": {
        "properties": {
          "target_scope": { "const": "full_document" },
          "answer_mode": { "const": "preview_replace" },
          "on_confirm_update_mode": { "const": "apply_replace" },
          "qa_update_policy": { "const": "n_a" }
        }
      }
    }
  ]
}
